target x86_64-unknown-linux-gnu

global @counter : size 8 align 8

func @stack_roundtrip(%0: i32) -> i32 {
  alloca %0 : i32 x 1 align 4 scope 0 lifetime scope "slot"
entry:
  .line 3
  .scope enter 0
  %1 = addrlocal %0
  store i32 %0 -> %1 align 4
  %2 = load i32, %1 align 4
  .scope exit 0
  ret %2
}

func @global_read() -> i64 {
entry:
  .line 12
  %0 = addrglobal @counter
  %1 = load i64, %0 align 8
  ret %1
}

func @copy(%0: ptr, %1: ptr) -> void {
entry:
  .line 19
  copymem %0 -> %1, 40i64 align 8
  setmem %0, 0i8, 8i64
  ret
}
