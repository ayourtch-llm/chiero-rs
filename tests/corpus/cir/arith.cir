target x86_64-unknown-linux-gnu

func @add3(%0: i32, %1: i32, %2: i32) -> i32 {
entry:
  .line 1
  %3 = add i32 %0, %1
  %4 = add i32 %3, %2
  ret %4
}

func @wrap() -> i32 {
entry:
  .line 6
  %0 = add i32 2147483647i32, 1i32
  ret %0
}

func @divzero() -> i32 {
entry:
  .line 12
  %0 = sdiv i32 5i32, 0i32
  ret %0
}
